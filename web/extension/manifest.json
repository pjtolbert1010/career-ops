{
  "manifest_version": 3,
  "name": "career-ops Apply",
  "version": "0.1.0",
  "description": "Opens a career-ops job posting in a new tab of your own Chrome and fills the application after you sign in. Never submits.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}

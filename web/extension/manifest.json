{
  "manifest_version": 3,
  "name": "career-ops Apply",
  "version": "0.4.0",
  "description": "Fills a job application in your own Chrome when you click its toolbar button, stops at sign-in pages and alerts you, highlights Submit and never presses it. Captures listings from signed-in session boards.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.calcareers.ca.gov/*",
    "https://*.jobs.ca.gov/*",
    "https://*.governmentjobs.com/*",
    "https://*.schooljobs.com/*",
    "https://*.calopps.org/*",
    "https://*.jobaps.com/*",
    "https://*.usajobs.gov/*",
    "https://*.edjoin.org/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.workday.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.workable.com/*",
    "https://*.applytojob.com/*",
    "https://*.breezy.hr/*",
    "https://*.recruitee.com/*",
    "https://*.paylocity.com/*",
    "https://*.ultipro.com/*",
    "https://*.ukg.com/*",
    "https://*.adp.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.csod.com/*",
    "https://*.brassring.com/*",
    "https://*.dayforcehcm.com/*",
    "https://*.paycomonline.net/*",
    "https://*.rippling.com/*",
    "https://*.teamtailor.com/*",
    "https://*.jazzhr.com/*",
    "https://*.pageuppeople.com/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.wellfound.com/*",
    "https://*.glassdoor.com/*",
    "https://*.remoteok.com/*",
    "https://*.remotive.com/*",
    "https://*.weworkremotely.com/*",
    "https://*.remote.co/*",
    "https://*.remotejobsfinder.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://calcareers.ca.gov/*ReviewApplication.aspx*",
        "https://*.calcareers.ca.gov/*ReviewApplication.aspx*"
      ],
      "js": [
        "calcareers-certify.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "career-ops: fill this application (click again to stop)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this application with career-ops"
    }
  },
  "icons": {
    "128": "icon128.png"
  }
}
